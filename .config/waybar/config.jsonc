{
      // show only hover
      "start_hidden": false,
      "ipc": true,
      "on-sigusr1": "hide",
      "on-sigusr2": "show",
      "layer": "top",
      "modules-left": [
            "clock",
            "hyprland/workspaces",
            "hyprland/window"
      ],
      "modules-center": [],
      "modules-right": [
            "memory",
            "cpu",
            "hyprland/submap",
            // "group/quick-net", // old "network" 
            "group/toolkit",
            "group/volume",
            "battery"
            // "custom/power"  (moved to SUPER + ESCAPE)
      ],
      "battery": {
            "interval": 60,
            "format": "{icon} {capacity}",
            "format-icons": {
                  "default": [
                        "󰂎",
                        "󰁺",
                        "󰁻",
                        "󰁼",
                        "󰁽",
                        "󰁾",
                        "󰁿",
                        "󰂀",
                        "󰂁",
                        "󰂂",
                        "󰁹"
                  ],
                  "charging": [
                        "󰢟",
                        "󰢜",
                        "󰂆",
                        "󰂇",
                        "󰂈",
                        "󰢝",
                        "󰂉",
                        "󰢞",
                        "󰂊",
                        "󰂋",
                        "󰂅"
                  ]
            }
      },

      "bluetooth": {
            "format": "",
            "format-disabled": "", // an empty format will hide the module
            "format-connected": " {num_connections}",
            "tooltip-format": "{controller_alias}\t{controller_address}",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
            "on-click": "exec kitty --title=bluetui -e bluetui"
      },
      "cpu": {
            "interval": 10,
            "format": " {}%",
            "max-length": 10,
            "on-click": "exec kitty --title=btop -e btop"
      },
      "memory": {
            "interval": 30,
            "format": " {percentage}%",
            "tooltip-format": "{used:0.1f}G/{total:0.1f}G used",
            "on-click": "exec kitty --title=htop -e htop"
      },


      "network": {
            "format-wifi": "<span color='#d9dadd'> </span>",
            "format-ethernet": "<span color='#d9dadd'> </span>",
            "format-disconnected": "<span color='#999a9e'>󰖪 </span>",
            "tooltip-format": "{ifname} via {gwaddr}",
            "tooltip-format-wifi": "{essid} ({signalStrength}%)",
            "tooltip-format-ethernet": "{ifname}",
            "tooltip-format-disconnected": "No Network",
            "on-click": "exec kitty --title=nmtui -e nmtui"
      },

      // HOVER NETWORK DRAWER (idea abondend)

      // // Grup Tanımı (Drawer)
      // "group/quick-net": {
      //       "orientation": "horizontal",
      //       "drawer": {
      //             "transition-duration": 500, // Genişleme hızı (milisaniye)
      //             "transition-left-to-right": true // Sola doğru açılması için (sağda duruyorsa)
      //       },
      //       "modules": [
      //             "network#icon", // Her zaman görünen ikon
      //             "network#text" // Hover yapınca açılan yazı
      //       ]
      // },

      // "network#icon": {
      //       "format-wifi": "<span color='#d9dadd'> </span>",
      //       "format-ethernet": "<span color='#d9dadd'> </span>",
      //       "format-disconnected": "<span color='#999a9e'>󰖪 </span>",
      //       "tooltip": false, // Tooltip'i kapatıyoruz çünkü zaten ismi açılacak
      //       "on-click": "exec kitty --title=nmtui -e nmtui"
      // },

      // "network#text": {
      //       "format-wifi": "{essid} ({signalStrength}%)",
      //       "format-ethernet": "{ipaddr}/{cidr}",
      //       "format-disconnected": "no network",
      //       "tooltip": false,
      //       "on-click": "exec kitty --title=nmtui -e nmtui"
      // },

      "clock": {
            "format": "<span color='#d9dadd'> </span>{:%H:%M}",
            //"format-alt": "<span foreground='#d9dadd'>🗓 </span><span>{:%a %d}</span>",
            "format-alt": "<span foreground='#d9dadd'>🗓 </span><span>{:%a, %b %d, %Y}</span>",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "calendar": {
                  "format": {
                        "today": "<span color='#75f1fa'><b>{}</b></span>"
                  }
            }
      },
      "pulseaudio": {
            "format": "{icon}",
            "format-muted": "",
            "format-icons": {
                  "headphone": " ",
                  "hands-free": " ",
                  "headset": " ",
                  "phone": " ",
                  "portable": " ",
                  "car": " ",
                  "default": [
                        " ",
                        " "
                  ]
            },
            "scroll-step": 1,
            "ignored-sinks": [
                  "Easy Effects Sink"
            ],
            "on-click": "pavucontrol"
      },
      "pulseaudio/slider": {
            "min": 0,
            "max": 100,
            "orientation": "horizontal"
      },
      "pulseaudio#percent": {
            "format": "{volume}%",
            "format-muted": "Mute",
            "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
      },
      "group/volume-drawer": {
            "orientation": "horizontal",
            "drawer": { // slider will appear on hover
                  "transition-duration": 500,
                  "transition-left-to-right": true
            },
            "modules": [
                  "pulseaudio",
                  "pulseaudio/slider"
            ]
      },
      "group/volume": {
            "orientation": "horizontal",
            "class": "volume-group",
            "modules": [
                  "group/volume-drawer",
                  "pulseaudio#percent"
            ]
      },
      // active window info
      "hyprland/window": {
            "format": " {title} ",
            "max-length": 40,
            "separate-outputs": true
      },
      "custom/arch": {
            "format": " ",
            "on-click": "sh /home/knightfall/.config/hypr/scripts/exec_wofi application_launcher"
      },
      "custom/power": {
            "format": "<span color='#fc8983' >⏻</span>",
            "on-click": "exec wlogout",
            "tooltip": true,
            "tooltip-format":"Logout Menu"
      },
      "custom/updates": {
          "exec": "bash ~/.config/waybar/scripts/updates.sh",
          "return-type": "json",
          "interval": 1800,
          "format": "{}",
          "on-click": "kitty -e sudo dnf upgrade",  
          "tooltip": true
      },
      "group/toolkit": {
            "orientation": "horizontal",
            "modules" : [
                  "bluetooth",
                  "custom/updates",
                  "network"
            ]

      }
}
