/* ---- 💫 https://github.com/JaKooLit 💫 ---- */

/* My Mostly Used waybar config incase you wonder :) */
{
      // show only hover
      "start_hidden": false,
      "ipc": true,
      "on-sigusr1": "hide",
      "on-sigusr2": "show",
      "layer": "top",
      "modules-left": [
            "clock",
            "hyprland/workspaces",
            "hyprland/window"
      ],
      "modules-center": [
      ],
      "modules-right": [
            "memory",
            "cpu",
            "hyprland/submap",
            "bluetooth",
            "network",
            "group/volume",
            "battery"
      ],
      "battery": {
            "interval": 60,
            "format": "{icon} {capacity}",
            "format-icons": {
                  "default": [
                        "󰂎",
                        "󰁺",
                        "󰁻",
                        "󰁼",
                        "󰁽",
                        "󰁾",
                        "󰁿",
                        "󰂀",
                        "󰂁",
                        "󰂂",
                        "󰁹"
                  ],
                  "charging": [
                        "󰢟",
                        "󰢜",
                        "󰂆",
                        "󰂇",
                        "󰂈",
                        "󰢝",
                        "󰂉",
                        "󰢞",
                        "󰂊",
                        "󰂋",
                        "󰂅"
                  ]
            }
      },
      "bluetooth": {
            "format": "",
            "format-disabled": "", // an empty format will hide the module
            "format-connected": " {num_connections}",
            "tooltip-format": "{controller_alias}\t{controller_address}",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
            "on-click": "exec kitty --title=bluetui -e bluetui"
      },
      "cpu": {
            "interval": 10,
            "format": " {}%",
            "max-length": 10,
            "on-click": "exec kitty --title=btop -e btop"
      },
      "memory": {
            "interval": 30,
            "format": " {percentage}%",
            "tooltip-format": "{used:0.1f}G/{total:0.1f}G used",
            "on-click": "exec kitty --title=htop -e htop"
      },
      "network": {
           "format": "{ifname}",
            "format-wifi": "<span color='#d9dadd'>  </span>{essid}({signalStrength}%)",
            "format-ethernet": "{ipaddr}/{cidr}  ",
            "format-disconnected": "<span color='#f25757'>󰖪  no network</span>",
            "tooltip-format": "󰊗  {ifname} via {gwaddr}",
            "tooltip-format-wifi": "  {essid} ({signalStrength}%)",
            "tooltip-format-ethernet": "  {ifname}",
            "tooltip-format-disconnected": "󰖪  no network",
            "max-length": 50,
            "on-click": "exec kitty --title=nmtui -e nmtui"
      },
      "clock": {
            "format": "<span color='#d9dadd'> </span>{:%H:%M}",
            //"format-alt": "<span foreground='#d9dadd'>🗓 </span><span>{:%a %d}</span>",
            "format-alt": "<span foreground='#d9dadd'>🗓 </span><span>{:%a, %b %d, %Y}</span>",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "calendar": {
                  "format": {
                        "today": "<span color='#75f1fa'><b>{}</b></span>"
                  }
            }
      },
      "pulseaudio": {
            "format": "{icon}",
            "format-muted": "",
            "format-icons": {
                  "headphone": " ",
                  "hands-free": " ",
                  "headset": " ",
                  "phone": " ",
                  "portable": " ",
                  "car": " ",
                  "default": [
                        " ",
                        " "
                  ]
            },
            "scroll-step": 1,
            "ignored-sinks": [
                  "Easy Effects Sink"
            ],
            "on-click": "pavucontrol"
      },

      "pulseaudio/slider": {
            "min": 0,
            "max": 100,
            "orientation": "horizontal"
      },

      "pulseaudio#percent": {
            "format": "{volume}%",
            "format-muted": "Mute",
            "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
      },

      "group/volume-drawer": {
            "orientation": "horizontal",
            "drawer": { // slider will appear on hover
                  "transition-duration": 500,
                  "transition-left-to-right": true
            },
            "modules": [
                  "pulseaudio",
                  "pulseaudio/slider"
            ]
      },

      "group/volume": {
            "orientation": "horizontal",
            "class": "volume-group",
            "modules": [
                  "group/volume-drawer",
                  "pulseaudio#percent"
            ]
      },

      // active window info
      "hyprland/window": {
            "format": " {title} ",
            "max-length": 40,
            "separate-outputs": true
      },

      "custom/arch": {
            "format": " ",
            "on-click": "sh /home/knightfall/.config/hypr/scripts/exec_wofi application_launcher"
      }
}

